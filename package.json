{
  "name": "fortunes-weave-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm guides:build && vite --host 127.0.0.1",
    "build": "pnpm guides:build && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "guides:import": "tsx scripts/guides.ts import",
    "guides:build": "tsx scripts/guides.ts build",
    "guides:verify": "tsx scripts/guides.ts verify",
    "pages:snapshot": "tsx scripts/pages.ts snapshot",
    "build:pages": "tsc --noEmit && tsx scripts/pages.ts build",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "preview:pages": "tsx tests/pages/server.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.38",
    "cheerio": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
